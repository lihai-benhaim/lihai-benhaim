{
  "name": "content-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI content studio: describe a story, approve the preview, publish it in your name to every network.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env apps/server/src/main.ts",
    "start": "node --env-file-if-exists=.env apps/server/src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
