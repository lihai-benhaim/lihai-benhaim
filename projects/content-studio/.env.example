# Copy to .env and fill in. Never commit .env.

# --- Basics ---------------------------------------------------------------
# Public HTTPS address of the studio (your Cloudflare Tunnel hostname).
PUBLIC_BASE_URL=https://studio.example.com
# openssl rand -base64 32   (encrypts tokens at rest, signs links; keep it safe, changing it unlinks all accounts)
APP_SECRET_KEY=
# Password for the web studio. openssl rand -hex 24
STUDIO_ADMIN_TOKEN=

# --- You ------------------------------------------------------------------
OWNER_NAME=Lihai Ben Haim
BRAND_ABOUT=Full stack and AI engineer. Builds products end to end.
BRAND_VOICE=Direct and warm, short sentences, no buzzwords, at most one emoji.
CONTENT_LANGUAGE=he
# Where to publish when a brief names no network (platform:format, comma separated).
DEFAULT_TARGETS=instagram:story,linkedin:feed_video

# --- AI -------------------------------------------------------------------
# Claude API key from console.anthropic.com. PLANNER=template runs without AI (for trying the flow).
ANTHROPIC_API_KEY=
PLANNER=claude
CLAUDE_MODEL=claude-opus-5-5
RESEARCH=on

# --- Publishing -----------------------------------------------------------
# dry-run: everything works except the final post, which is only recorded. Switch to live when ready.
PUBLISH_MODE=dry-run

# Instagram (Meta app, "Instagram API with Instagram Login"). docs/platforms.md
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v23.0

# LinkedIn (developer app with "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect").
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202510

# --- WhatsApp (optional; all five or none) -----------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any random string; paste the same value in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Your own number, international format, digits only. Only this number can use the bot.
OWNER_WHATSAPP=9725XXXXXXXX
WHATSAPP_GRAPH_VERSION=v23.0

# --- Rendering ------------------------------------------------------------
# The Docker image sets FONT_FILE to Noto Sans Hebrew. Optional background music (mp3/m4a):
# MUSIC_FILE=/data/music/default.mp3

# --- NAS / docker compose ---------------------------------------------------
# Folder on the NAS for state.json and media, e.g. /volume1/docker/content-studio/data
STUDIO_DATA_PATH=./data
STUDIO_UID=1000
STUDIO_GID=1000
STUDIO_PORT=8080
CLOUDFLARE_TUNNEL_TOKEN=
